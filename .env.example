PORT=3000
ADPULSE_HOST_PORT=3008
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-secret
EVENT_SECRET=change-this-too
DB_PATH=./data/adpulse.db
PUBLISHER_REVENUE_SHARE=0.75
ADMIN_EMAIL=admin@adpulse.local
ADMIN_PASSWORD=ChangeMe123!
DEMO_MODE=true

# Xdigitex Pay
XDIGITEX_PAY_BASE_URL=https://pay.xdigitex.space/api
XDIGITEX_PAY_API_KEY=replace-with-dashboard-api-key
KYC_REQUIRED=true

ADPULSE_SELLER_DOMAIN=ads.example.com

# Production stores
DATABASE_URL=postgres://adpulse:change-me@postgres:5432/adpulse
POSTGRES_PASSWORD=change-me
DATABASE_SSL=false
REDIS_URL=redis://:replace-with-a-strong-random-secret@redis:6379
REDIS_PASSWORD=replace-with-a-strong-random-secret
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=adpulse
CLICKHOUSE_PASSWORD=change-me

# Traffic intelligence
IPINFO_TOKEN=

# AI contextual classification (OpenAI-compatible chat completion endpoint or internal service)
AI_CONTEXT_API_URL=
AI_CONTEXT_API_KEY=
AI_CONTEXT_MODEL=

# Customer support
SUPPORT_EMAIL=sales@example.com
SUPPORT_WHATSAPP=
SUPPORT_CHAT_ENABLED=true

PRODUCTION_STORES_REQUIRED=false

# Authentication and creatives
GOOGLE_CLIENT_ID=
UPLOAD_DIR=./public/uploads
MINIMUM_PAYOUT_USD=5

MINIMUM_PAYOUTS_JSON={"KES":500,"UGX":18000,"RWF":7000,"CDF":12000,"XOF":3000,"XAF":3000,"ZMW":120,"SLE":120}

# Social / Creator Network. Manual verification + export work without OAuth keys.
SOCIAL_PUBLIC_URL=https://ads.example.com
# Generate a unique 32-byte key, base64 or 64 hex chars. Keep it backed up securely.
SOCIAL_TOKEN_ENCRYPTION_KEY=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SOCIAL_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://ads.example.com/api/social/tiktok/callback
TIKTOK_SCOPES=user.info.basic
TIKTOK_PUBLISH_APPROVED=false
TIKTOK_API_VERIFIED=false
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://ads.example.com/api/social/facebook/callback
# Set an active supported version from your Meta app dashboard, e.g. vXX.0.
META_GRAPH_VERSION=
INSTAGRAM_LOGIN_MODE=instagram
# Optional Instagram product credentials when they differ from the Meta app ID/secret.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://ads.example.com/api/social/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic
INSTAGRAM_PUBLISH_APPROVED=false
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement
FACEBOOK_PUBLISH_APPROVED=false
META_API_VERIFIED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://ads.example.com/api/social/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_PUBLISH_APPROVED=false
YOUTUBE_API_VERIFIED=false
